#!/bin/sh
# What an AppImage runs: the desktop front end, or with `kiln` as the first argument the
# command line tool (`./kiln-*.AppImage kiln doctor`). The front end finds `kiln` and the
# runtime library beside itself, in usr/bin.
here="$(dirname "$(readlink -f "$0")")"
case "${1:-}" in
    kiln)
        shift
        exec "$here/usr/bin/kiln" "$@"
        ;;
    *)
        exec "$here/usr/bin/kiln-gui" "$@"
        ;;
esac
